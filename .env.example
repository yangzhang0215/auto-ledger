APP_NAME=Auto Ledger
TZ=Asia/Shanghai
DATABASE_URL=sqlite:///./data/bookkeeping.db

# Domain for reverse proxy (Caddy)
DOMAIN=ledger.example.com
ACME_EMAIL=you@example.com

# Telegram Bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
# Comma-separated list of allowed Telegram chat IDs (leave empty to allow all)
TELEGRAM_ALLOWED_CHAT_IDS=
# If you run tg polling mode (`docker compose --profile tg-polling up -d`),
# webhook will be disabled automatically for this bot.

# WeChat Official Account
WECHAT_TOKEN=
